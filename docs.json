{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Shortrange.tech Docs Site",
  "colors": {
    "primary": "#fab800",
    "light": "#ffc933",
    "dark": "#f3b200"
  },
  "favicon": {
    "light": "/images/android-chrome-512x512.png",
    "dark": "/images/android-chrome-512x512.png"
  },
  "logo": {
    "light": "/images/light-docs-logo.png",
    "dark": "/images/docs-logo-dark.png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "OpenDoorSim Docs",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "opendoorsim/introduction",
              "opendoorsim/getting-started"
            ],
            "icon": "planet-ringed"
          },
          {
            "group": "Build Guides",
            "icon": "hammer",
            "pages": [
              "opendoorsim/build-guides/screen-and-encoder",
              "opendoorsim/build-guides/lab-case"
            ]
          },
          {
            "group": "User Manuals",
            "icon": "book-open",
            "pages": [
              "opendoorsim/user-manuals/flashing-firmware",
              "opendoorsim/user-manuals/operating-guide",
              "opendoorsim/user-manuals/configuration",
              "opendoorsim/user-manuals/troubleshooting"
            ]
          },
          {
            "group": "Self Manufacture",
            "icon": "industry-windows",
            "pages": [
              "self-manufacture-overview",
              {
                "group": "OpenDoorSim Board",
                "pages": [
                  "opendoorsim/board-manufacturing-guide",
                  "opendoorsim/build-guides/open-door-sim-board"
                ]
              },
              {
                "group": "Screen and Encoder",
                "pages": [
                  "bill-of-materials-screen-encoder"
                ]
              },
              {
                "group": "LAB Case",
                "pages": [
                  "bill-of-materials-lab",
                  "3-d-print-guide"
                ]
              }
            ]
          }
        ],
        "icon": "binary"
      },
      {
        "tab": "Events & Talks",
        "groups": [
          {
            "group": "Upcoming Events",
            "pages": [
              "events/upcoming",
              "events/calendar"
            ]
          },
          {
            "group": "Talks Archive",
            "pages": [
              "talks/archive",
              "talks/featured"
            ]
          }
        ],
        "hidden": true
      },
      {
        "tab": "Quick Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/overview",
              "reference/glossary",
              "reference/faq",
              "reference/resources"
            ]
          }
        ],
        "hidden": true
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Buy An Official Kit",
          "icon": "store",
          "href": "https://shortrange.tech",
          "color": {
            "light": "#fab800",
            "dark": "#fab800"
          }
        },
        {
          "anchor": "GitHub Repository",
          "icon": "code",
          "color": {
            "light": "#fab800",
            "dark": "#fab800"
          },
          "href": "https://github.com/shortrangetech/opendoorsim"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/shortrangetech"
      },
      {
        "href": "https://shortrange.tech",
        "label": "Return to Shortrange.tech"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/shortrangetechnologies"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/shortrangetech",
      "linkedin": "https://www.linkedin.com/in/shortrange",
      "youtube": "https://www.youtube.com/@ShortrangeTech",
      "website": "https://shortrange.tech"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "grid"
  },
  "description": "Shortrange.tech Docs Hub is the central documentation resource for the OpenDoorSim project and other RF learning resources. Whether you’re building your first OpenDoorSim, looking for Shortrange’s workshops and talks, past recordings, or just looking for a quick reference, you’ll find it all here."
}
